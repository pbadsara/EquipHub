# Server (PORT is optional locally; the default is 5050)
PORT=5050

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/equiphub?appName=Cluster0

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me

# Address of the frontend (used in password reset and Stripe return links)
FRONTEND_URL=http://localhost:5173

# Password reset emails (Resend)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Payments (Stripe test mode secret key). Needed for checkout.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Image uploads (Cloudinary). Optional: keep this line commented out unless you have a real URL.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>