# Server
PORT=5000
NODE_ENV=development

# MongoDB
# For real development/production, replace with your MongoDB Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/equiphub?retryWrites=true&w=majority
# While Atlas isn't set up yet, you can run a local MongoDB and point this at it instead.
MONGODB_URI=mongodb://127.0.0.1:27017/equiphub

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Admin seed script (used only by scripts/createAdmin.js, never by the public API)
ADMIN_SEED_EMAIL=admin@equiphub.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=EquipHub Admin
